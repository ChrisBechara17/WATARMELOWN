@model IEnumerable<SimpleMarketApp.Models.Item>
@{
    decimal total = ViewBag.Total ?? 0;
}

<h2>Your Cart</h2>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Name</th><th>Price</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>$@item.Price</td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Total: $@total</h4>

    <form asp-action="Purchase" method="post">
        <button type="submit" class="btn btn-success">Purchase</button>
    </form>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-success mt-3">@ViewBag.Message</div>
}
